# WebRTC TURN server configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# If these are unset, vibeshine falls back to STUN-only (works on most home
# networks but fails on symmetric NAT / strict corporate firewalls).
#
# SUNSHINE_TURN_HOST      — IP or hostname of your Coturn server (no protocol prefix)
# SUNSHINE_TURN_USER      — TURN username configured in turnserver.conf
# SUNSHINE_TURN_CREDENTIAL — TURN password configured in turnserver.conf
#
# To override the full ICE server list (STUN + TURN) as raw JSON instead,
# set SUNSHINE_WEBRTC_ICE_SERVERS (takes precedence over the vars above).

SUNSHINE_TURN_HOST=
SUNSHINE_TURN_USER=
SUNSHINE_TURN_CREDENTIAL=
